# ==========================================
# Comprehensive Git Ignore for Document Vault
# ==========================================

# 1. Environment & Secret Variables (Never commit to git!)
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# 2. Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
dist/
build/

# 3. Database & Local Storage
*.db
*.sqlite
*.sqlite3
auth.db
backend/auth.db
backend/uploads/
uploads/

# 4. Node.js & Frontend Builds
node_modules/
frontend/node_modules/
frontend/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS & Editor Cache
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

